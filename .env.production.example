# PLANT-COMMONS: production template for https://plant-commons.ipk-gatersleben.de
#
# Placeholders only. NEVER put real secrets in this file. In the cluster, secrets come from a
# Kubernetes Secret and everything else from a ConfigMap (see docs/plant-commons/configuration.md,
# which documents every variable, its service, and its source).
#
# This file mirrors .env.example so that `docker compose --env-file .env.production.example config`
# can validate that every variable referenced by docker-compose.yml is defined. Do NOT run the
# stack with production settings via compose; the Helm chart (Phase 5) is the deployment path.
#
# Convention: lines marked "# PLANT-COMMONS:" differ from .env.example.
# Values written as CHANGE_ME_* must be replaced; they are deliberately not usable.

################ WARNING ################
# Using special characters in the values (e.g. in passwords or secrets) might corrupt some processes.
# PLANT-COMMONS: concretely, POSTGRES_AUTHENTICATOR_PASSWORD is sed-substituted into SQL with "/" as
# delimiter and embedded unescaped in PGRST_DB_URI. Use hex/alphanumeric only. Generate with:
#   openssl rand -hex 32
################ WARNING ################

# ---- DOCKER PROJECT SETTINGS ----------

# PLANT-COMMONS: only meaningful for docker compose; ignored in Kubernetes.
COMPOSE_PROJECT_NAME="plant-commons"

# ---- PUBLIC ENV VARIABLES -------------

# postgresql
# PLANT-COMMONS: in-cluster Service name of the PostgreSQL StatefulSet (chart sets the real name)
POSTGRES_DB_HOST=database
POSTGRES_DB_HOST_PORT=5432
POSTGRES_DB=rsd-db
POSTGRES_USER=rsd

# backend (postgREST)
PGRST_DB_ANON_ROLE=rsd_web_anon
PGRST_DB_SCHEMA=public
PGRST_SERVER_PORT=3500
PGRST_ADMIN_SERVER_PORT=3501
# PLANT-COMMONS: not in .env.example. docker-compose.yml hardcodes PGRST_SERVER_HOST=backend, which is
# a Docker-network alias. In Kubernetes "backend" resolves to the Service ClusterIP, which is not a
# local address, so PostgREST cannot bind to it. The chart must set 0.0.0.0 (compose ignores this var).
PGRST_SERVER_HOST=0.0.0.0

# postgREST API, internal (server-side calls from frontend, auth, scrapers, codemeta)
# PLANT-COMMONS: in-cluster Service name and port of the PostgREST Service
POSTGREST_URL=http://backend:3500

# postgREST API reachable from the internet (only consumed by swagger)
# PLANT-COMMONS: public URL
POSTGREST_URL_EXTERNAL=https://plant-commons.ipk-gatersleben.de/api/v1

# RSD Auth module, consumed by frontend SERVER-SIDE only (providers list, token refresh)
# PLANT-COMMONS: internal URL, same as upstream .env. Browsers use the relative path /auth.
# See docs/plant-commons/configuration.md for why this is not the public URL.
RSD_AUTH_URL=http://auth:7000/auth

RSD_API_ACCESS_TOKEN_ENABLED=true

# PLANT-COMMONS: public base URL, no trailing slash. The auth service builds the OAuth redirect
# URIs from it: ${HOST_URL}/auth/login/orcid and ${HOST_URL}/auth/couple/orcid
HOST_URL=https://plant-commons.ipk-gatersleben.de

# RSD Reverse Proxy URL, consumed by frontend; only used to load frontend plugins
# (${RSD_REVERSE_PROXY_URL}/plugin/<name>), which Plant Commons does not configure.
# PLANT-COMMONS: nginx does not exist in Kubernetes; point at the public URL to avoid a dead hostname
RSD_REVERSE_PROXY_URL=https://plant-commons.ipk-gatersleben.de

# PLANT-COMMONS: must be "prod". "dev" makes the first user to log in an admin and changes
# SURFconext login behaviour.
RSD_ENVIRONMENT=prod

# PLANT-COMMONS: ORCID only. SURFCONEXT/HELMHOLTZ/AZURE/LINKEDIN/GITHUB/LOCAL are omitted, which
# means DISABLED. Never add LOCAL here. Choice between INVITE_ONLY and EVERYONE:
# see docs/plant-commons/configuration.md.
RSD_AUTH_PROVIDERS=ORCID:INVITE_ONLY

# SURFCONEXT: not used. Left empty on purpose (upstream example points at a test environment).
SURFCONEXT_CLIENT_ID=
SURFCONEXT_WELL_KNOWN_URL=

# Helmholtz ID: not used. Left empty on purpose.
HELMHOLTZID_CLIENT_ID=
HELMHOLTZID_WELL_KNOWN_URL=
HELMHOLTZID_SCOPES=
#HELMHOLTZID_ALLOW_EXTERNAL_USERS=true

# ORCID
# PLANT-COMMONS: client id of the PRODUCTION ORCID API client (format APP-XXXXXXXXXXXXXXXX).
# The upstream value APP-4D4D69ASWTYOI9QI is the shared sandbox client; do not use it.
ORCID_CLIENT_ID=APP-T1MHJINJKL8PTMXA
# PLANT-COMMONS: production OpenID discovery (upstream example uses sandbox.orcid.org)
ORCID_WELL_KNOWN_URL=https://orcid.org/.well-known/openid-configuration

# AZURE ACTIVE DIRECTORY: not used.
AZURE_CLIENT_ID=
AZURE_WELL_KNOWN_URL=
AZURE_DISPLAY_NAME=
AZURE_DESCRIPTION_HTML=
AZURE_ORGANISATION=

# LINKEDIN: not used.
LINKEDIN_CLIENT_ID=
LINKEDIN_WELL_KNOWN_URL=

# GITHUB: not used.
GITHUB_CLIENT_ID=
GITHUB_WELL_KNOWN_URL=

# E-MAIL SERVICE (optional "mail" profile; not planned, see docs/plant-commons/services.md)
MAIL_SMTP_SERVER=
MAIL_SMTP_PORT=
MAIL_SMTP_SECURITY=
MAIL_SMTP_LOGIN=
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
MAIL_QUEUE=mailq

# ---- PUBLIC SCRAPER ENV VARIABLES -------------
# Only relevant if the optional scrapers are deployed (open question 7).
MAX_REQUESTS_GITHUB=6
MAX_REQUESTS_GITLAB=6
MAX_REQUESTS_4TU=6
MAX_REQUESTS_CODEBERG=6
MAX_REQUESTS_DOI=6
MAX_REQUESTS_OPENALEX=6
MAX_REQUESTS_ROR=6

# PLANT-COMMONS: all three are for the NLeSC instance only; keep false
ENABLE_4TU_SCRAPER=false
ENABLE_NASSA_SCRAPER=false
ENABLE_ESCAPE_OSSR_SCRAPER=false

# ---- SECRETS ------ SECRETS -----------
# PLANT-COMMONS: placeholders only. Real values live in a Kubernetes Secret.

# consumed by services: database (first init only), background-services
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# consumed by services: database (first init only), backend
POSTGRES_AUTHENTICATOR_PASSWORD=CHANGE_ME_openssl_rand_hex_32

# consumed by services: auth, frontend, scrapers, codemeta; at least 32 characters
PGRST_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# MAIL SERVICE: not used
MAIL_SMTP_PASSWORD=

# PUBLISHER: not used
PUBLISHER_JWT_SECRET_KEY=

# Providers not used
AUTH_SURFCONEXT_CLIENT_SECRET=
AUTH_HELMHOLTZID_CLIENT_SECRET=
AUTH_AZURE_CLIENT_SECRET=
AUTH_LINKEDIN_CLIENT_SECRET=
AUTH_GITHUB_CLIENT_SECRET=

# ORCID client secret of the production client
AUTH_ORCID_CLIENT_SECRET=CHANGE_ME_from_orcid_developer_tools

# scrapers (optional)
API_CREDENTIALS_GITHUB=
ZENODO_ACCESS_TOKEN=
# consumed by: scrapers, frontend (Crossref "polite" pool); use a monitored address
# PLANT-COMMONS: set to a mailbox IPK actually reads
CROSSREF_CONTACT_EMAIL=
OPENALEX_API_KEY=
LIBRARIES_IO_ACCESS_TOKEN=

# Matomo (frontend); leave empty to disable tracking
MATOMO_URL=
MATOMO_ID=
